# Скопируй этот файл в .env и заполни своими значениями,
# либо задай эти же переменные в настройках хостинга (Railway/Render).

# Токен, который выдал @BotFather (см. README.md, шаг 1)
BOT_TOKEN=

# Необязательные настройки (можно не трогать — значения по умолчанию уже подходят)
NEW_WORDS_PER_DAY=27
TIMEZONE=Asia/Qyzylorda
MORNING_HOUR=8
MORNING_MINUTE=0
EVENING_HOUR=19
EVENING_MINUTE=30
TECHNICAL_SHARE=0.5

# Опционально: если захочешь подключить платный "умный" диалог через OpenAI,
# впиши сюда ключ (не обязательно для работы бота).
OPENAI_API_KEY=
